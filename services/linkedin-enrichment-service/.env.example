# LinkedIn Enrichment Service - Environment Configuration

# ============================================
# Server Configuration
# ============================================

# Port to run the service on (default: 4200)
PORT=4200

# Host to bind to (default: 0.0.0.0)
HOST=0.0.0.0

# Node environment (development | production)
NODE_ENV=development

# CORS allowed origins (comma-separated, or * for all)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================
# Firestore credentials (choose one strategy - matches prospect-api pattern)
# ============================================

# For Cloud Run deployment: Leave empty to use Application Default Credentials (ADC)
# The service will automatically use the Cloud Run service account's permissions
# Make sure to deploy to the arbol-outreach-machine GCP project

# For local development only: Point to service account file
# GOOGLE_APPLICATION_CREDENTIALS=../prospect-api/arbol-outreach-machine-credentials.json

# Alternative: Inline credentials (if needed)
# GOOGLE_APPLICATION_CREDENTIALS_JSON={...raw service account json...}
# GOOGLE_APPLICATION_CREDENTIALS_B64=base64-encoded-service-account-json

# ============================================
# Google Custom Search (either API key or service-account scopes)
# ============================================
GOOGLE_API_KEY=replace-with-google-api-key
GOOGLE_CSE_ID=12413e62e1382465a
# GOOGLE_SERVICE_ACCOUNT_FILE=../leadgen-475923-29d2eed038e0.json
# GOOGLE_SERVICE_ACCOUNT_SCOPES=https://www.googleapis.com/auth/customsearch

# ============================================
# OpenAI
# ============================================
OPENAI_API_KEY=replace-with-openai-key
OPENAI_MODEL=gpt-4o-mini

# ============================================
# Toggle dry-run mode (set to 1 to skip external APIs)
# ============================================
ENRICHMENT_DRY_RUN=1
