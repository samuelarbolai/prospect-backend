# HTTP listener port for local development
PORT=4000

# Firestore credentials (choose one strategy)
# GOOGLE_APPLICATION_CREDENTIALS_JSON={...raw service account json...}
# GOOGLE_APPLICATION_CREDENTIALS_B64=base64-encoded-service-account-json

# CORS configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Enrichment routing
DEFAULT_QUEUE_LIST_ID=enrichment_queue
OUTREACH_READY_LIST_ID=outreach_ready
ENRICHMENT_JOBS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/prospect-enrichment-jobs
AWS_REGION=us-east-1
